# -------------------------
# Data (never commit datasets)
# -------------------------
data/raw/
data/zips/

# Ignore everything by default
data/*

# Allow processed outputs
#!data/preprocessed_manifests
#!data/preprocessed_manifests/*
#!data/*.csv
# -------------------------
# Large files / archives
# -------------------------
*.zip
*.tar
*.tar.gz
*.7z

# -------------------------
# Model weights / checkpoints
# -------------------------
*.h5
*.pt
*.pth
*.ckpt
*.onnx

# -------------------------
# Jupyter / Python
# -------------------------
.ipynb_checkpoints/
__pycache__/
*.pyc
*.pyo

# -------------------------
# Virtual environments
# -------------------------
venv/
.env/
.venv/

# -------------------------
# OS / editor files
# -------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Generated figures / plots
# -------------------------
*.png
*.jpg
*.jpeg
